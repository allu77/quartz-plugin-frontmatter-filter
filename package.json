{
  "name": "quartz-plugin-frontmatter-filter",
  "version": "0.1.0",
  "description": "Quartz v5 filter plugin that decides which notes are published based on frontmatter rules",
  "type": "module",
  "license": "MIT",
  "keywords": ["quartz", "quartz-plugin", "filter", "frontmatter"],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "frontmatter-filter",
    "displayName": "Frontmatter Filter",
    "category": "filter",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": { "defaultPublish": true }
  },
  "engines": { "node": ">=22" }
}
